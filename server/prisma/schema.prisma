generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  RECEPTIONIST
  DOCTOR
  PHARMACIST
  PATIENT
}

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Organization {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  email           String?
  phone           String?
  address         String?
  logo            String?
  timezone        String   @default("UTC")
  currency        String   @default("USD")
  gstVat          String?
  hospitalLicense String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users         User[]
  patients      Patient[]
  medicines     Medicine[]
  notifications Notification[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  labTests      LabTest[]
  labResults    LabResult[]
  invoices      Invoice[]
  payments      Payment[]
  featureFlags  FeatureFlag[]
  departments  Department[]
  settings     OrgSetting[]
  leaveRequests LeaveRequest[]
}

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  price       Float    @default(0)
  maxUsers    Int      @default(5)
  maxPatients Int      @default(100)
  features    String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id             String   @id @default(uuid())
  startDate      DateTime @default(now())
  endDate        DateTime?
  status         String   @default("ACTIVE")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  planId         String
  plan           Plan     @relation(fields: [planId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices Invoice[]

  @@unique([organizationId, planId])
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  entity         String
  entityId       String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  createdAt      DateTime @default(now())
}

model FileAttachment {
  id             String   @id @default(uuid())
  filename       String
  originalName   String
  mimeType       String
  size           Int
  path           String
  entity         String
  entityId       String
  organizationId String
  uploadedById   String?
  createdAt      DateTime @default(now())

  @@unique([entity, entityId, filename])
}

model LabTest {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  results LabResult[]
}

model LabResult {
  id        String   @id @default(uuid())
  result    Json
  notes     String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  labTestId String
  labTest   LabTest  @relation(fields: [labTestId], references: [id])
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  doctorId  String
  doctor    User     @relation(fields: [doctorId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String
  password       String
  role           Role
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])

  consultations     Consultation[]
  doctorAppointments Appointment[]  @relation("DoctorAppointments")
  notifications     Notification[]
  labResults        LabResult[]
  schedules         StaffSchedule[]

  @@unique([email, organizationId])
}

model Patient {
  id        String   @id @default(uuid())
  patientId String
  name      String
  phone     String?
  email     String?
  password  String?
  gender    Gender
  age       Int      @default(0)
  dob       DateTime?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  appointments  Appointment[]
  prescriptions Prescription[]
  sales         Sale[]
  labResults    LabResult[]
  invoices      Invoice[]
  payments      Payment[]

  @@unique([patientId, organizationId])
}

model Appointment {
  id              String            @id @default(uuid())
  token           Int
  status          AppointmentStatus @default(SCHEDULED)
  date            DateTime          @default(now())
  validUntil      DateTime?
  notes           String?
  consultationFee Float             @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  doctorId    String
  doctor      User              @relation("DoctorAppointments", fields: [doctorId], references: [id])

  consultation Consultation?

  @@unique([doctorId, token, date])
}

model Consultation {
  id        String   @id @default(uuid())
  diagnosis String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointmentId String   @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  doctorId      String
  doctor        User       @relation(fields: [doctorId], references: [id])

  prescriptions Prescription[]
}

model Prescription {
  id        String   @id @default(uuid())
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id])

  items PrescriptionItem[]
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  dosage         String
  duration       String
  instructions   String?
  quantity       Int          @default(1)

  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicineId     String
  medicine       Medicine     @relation(fields: [medicineId], references: [id])
}

model Medicine {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  expiryDate  DateTime?
  batchNumber String?
  reorderLevel Int     @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  prescriptionItems PrescriptionItem[]
  saleItems         SaleItem[]
}

model Sale {
  id        String   @id @default(uuid())
  total     Float
  createdAt DateTime @default(now())

  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])

  items SaleItem[]
}

model SaleItem {
  id         String @id @default(uuid())
  quantity   Int
  unitPrice  Float
  total      Float

  saleId     String
  sale       Sale   @relation(fields: [saleId], references: [id])
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Invoice {
  id             String   @id @default(uuid())
  invoiceNumber  String   @unique
  amount         Float
  tax            Float    @default(0)
  total          Float
  description    String?
  status         String   @default("DRAFT")
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  patientId      String?
  patient        Patient? @relation(fields: [patientId], references: [id])

  items InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  total       Float

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id             String   @id @default(uuid())
  amount         Float
  method         String   @default("CASH")
  reference      String?
  notes          String?
  status         String   @default("COMPLETED")
  createdAt      DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
  patientId      String?
  patient        Patient? @relation(fields: [patientId], references: [id])
}

model FeatureFlag {
  id             String   @id @default(uuid())
  key            String
  name           String
  description    String?
  isEnabled      Boolean  @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([key, organizationId])
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt
}

model Department {
  id              String   @id @default(uuid())
  name            String
  description     String?
  consultationFee Float    @default(0)
  workingHours    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  users User[]

  @@unique([name, organizationId])
}

model OrgSetting {
  id        String   @id @default(uuid())
  key       String
  value     String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([key, organizationId])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  module      String
  action      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  id           String   @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([role, permissionId])
}

model UserPermission {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  granted      Boolean   @default(true)
  createdAt    DateTime @default(now())

  @@unique([userId, permissionId])
}

model StaffSchedule {
  id          String   @id @default(uuid())
  dayOfWeek   Int
  startTime   String
  endTime     String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id])

  @@unique([userId, dayOfWeek])
}

model LeaveRequest {
  id          String   @id @default(uuid())
  userId      String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String   @default("PENDING")
  approvedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}
